// "$schema": "https://zed.dev/schema/tasks.json"
[
  {
    "label": "Build",
    "command": "deno",
    "args": ["task", "build"],
    "hide": "on_success"
  },
  // See https://github.com/sannybuilder/dev/issues/391
  // FIXME: 😕 This simply doesn't work...
  {
    "label": "Build Current Script",
    "shell": "system",
    "command": "sanny.exe",
    "args": [
      "--no-splash",
      "--mode",
      "gta3_sbl",
      "--compile",
      "$ZED_FILE"
    ],
    "hide": "on_success"
  },
  {
    "label": "Install",
    "command": "deno",
    "args": ["task", "install"],
    "hide": "on_success"
  },
  {
    "label": "Run",
    "command": "deno",
    "args": ["task", "run"],
    "hide": "on_success"
  },
  {
    "label": "Open Map Editor",
    "command": "deno",
    "args": ["task", "map-editor"],
    "hide": "on_success"
  },
  {
    "label": "Open Mission Editor",
    "command": "deno",
    "args": ["task", "editor"],
    "hide": "on_success",
  },
  {
    "label": "Format Documentation",
    "command": "deno",
    "args": ["fmt", "./**/*.md"],
    "hide": "on_success"
  },
  {
    "label": "Clean",
    "command": "deno",
    "args": ["task", "clean"],
    "hide": "on_success"
  }
]
