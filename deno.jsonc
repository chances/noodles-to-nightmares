{
  "nodeModulesDir": "auto",
  "workspace": ["./lib/fsm", "./tools/mission-editor"],
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 lib scripts",
    "clean": "deno run --allow-read --allow-write scripts/clean.ts",
    "build": "deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run scripts/build.ts",
    "build:missions": "deno run --allow-read --allow-write scripts/sync-missions.ts",
    "install": "deno task build && deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run scripts/install.ts",
    "run": "deno task install && deno run --env-file=.env --allow-env --allow-read --allow-write=dist/telemetry --allow-net=127.0.0.1:8089 --allow-run scripts/run.ts",
    "map-editor": "deno run --env-file=.env --allow-env --allow-read --allow-run scripts/map-editor.ts",
    // Mission Editor
    // FIXME: HMR is innefectual in desktop app; fix tools/mission-editor/deno.json dev task
    "editor": "deno task --cwd tools/mission-editor dev",
    "editor:serve": "deno task --cwd tools/mission-editor serve",
    "editor:build": "deno task --cwd tools/mission-editor build",
    // Utilities
    "probe": "deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run scripts/install-probe.ts",
    "find-free-ids": "deno run --env-file=.env --allow-env --allow-read scripts/find-free-ids.ts",
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.3.1",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.5.0",
    "change-case": "npm:change-case@^5.4.4"
  }
}
